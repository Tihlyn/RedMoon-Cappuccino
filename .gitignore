bin/x64/*
!bin/x64/Release/
obj/
*.user
*.suo

# IDE
.vs/
.vscode/
.idea/
*.DS_Store

# Packed plugin zips (exclude all except the release artifact)
*.zip
!/RedMoonCappuccino.zip

