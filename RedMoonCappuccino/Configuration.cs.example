using System;
using System.Collections.Generic;
using Dalamud.Configuration;

namespace RedMoonCappuccino;

[Serializable]
public class Configuration : IPluginConfiguration
{
    public int Version { get; set; } = 0;

    public bool ShowOnLogin           { get; set; } = true;
    public bool IsConfigWindowMovable { get; set; } = true;

    /// <summary>WebSocket server address. Changeable without recompile.</summary>
    public string WsServerAddress { get; set; } = "ws://YOUR_SERVER_ADDRESS:PORT";

    /// <summary>Live-chat WebSocket server address (separate server from <see cref="WsServerAddress"/>).</summary>
    public string ChatWsServerAddress { get; set; } = "ws://YOUR_SERVER_ADDRESS:CHAT_PORT";

    /// <summary>Font scale for the live-chat room history. 1.0 = default size.</summary>
    public float ChatRoomFontScale { get; set; } = 1.0f;

    /// <summary>Font scale for live-chat direct-message history. 1.0 = default size.</summary>
    public float ChatDmFontScale { get; set; } = 1.0f;

    // ── Event notifications ───────────────────────────────────────────────────

    /// <summary>Opt-in: show pop-up notifications for new events and event start reminders.</summary>
    public bool EnableEventNotifications { get; set; } = false;

    /// <summary>Event IDs the user wants a reminder for, 10 minutes before start.</summary>
    public List<string> EventReminderIds { get; set; } = new();

    /// <summary>Event IDs already seen, so the new-event notification fires only once per event.</summary>
    public List<string> KnownEventIds { get; set; } = new();

    // ── Free company roster sync ──────────────────────────────────────────────

    /// <summary>Report the free company roster to the server. Only member names are ever sent.</summary>
    public bool FcRosterSync { get; set; } = true;

    /// <summary>
    /// Free company the roster is reported for. Nothing is read or sent while the
    /// logged-in character belongs to any other free company.
    /// </summary>
    public string FcRosterName { get; set; } = "Seventh Haven";

    /// <summary>
    /// Ask the game to reload the member list on a timer. With this off the roster
    /// only refreshes when the player opens the free company window themselves.
    /// </summary>
    public bool FcRosterActiveRefresh { get; set; } = true;

    /// <summary>Minutes between member-list reloads. Floored at 5 to stay well clear of rate limits.</summary>
    public int FcRosterRefreshMinutes { get; set; } = 15;

    // ── Submersible route planner ─────────────────────────────────────────────

    /// <summary>
    /// Submarines last read from the free company workshop. Cached because the
    /// game only exposes them while the player stands in the workshop, and the
    /// planner is most useful everywhere else.
    /// </summary>
    public List<Models.SavedSubmarine> KnownSubmarines { get; set; } = new();

    // ── Gemini / Rotation Recorder ────────────────────────────────────────────

    /// <summary>Google AI Studio API key. Never log or display in plain text.</summary>
    public string GeminiApiKey { get; set; } = "";

    /// <summary>Number of grounded queries sent today (UTC date).</summary>
    public int    DailyGroundedCount { get; set; } = 0;

    /// <summary>UTC date string "yyyy-MM-dd" of the last recorded query.</summary>
    public string GroundedCountDate  { get; set; } = "";

    /// <summary>Show a warning in the UI when remaining drops to this many.</summary>
    public const int GroundedSoftWarnAt = 50;

    /// <summary>
    /// Hard limit enforced by the plugin. Google's free tier is 500 RPD.
    /// Capped at 450 to leave a buffer against clock skew.
    /// </summary>
    public const int GroundedHardLimit = 450;

    /// <summary>
    /// Remaining grounded queries for today.
    /// Automatically resets DailyGroundedCount when the UTC date changes.
    /// </summary>
    public int GroundedRemaining
    {
        get
        {
            EnsureDateReset();
            return GroundedHardLimit - DailyGroundedCount;
        }
    }

    /// <summary>True when at least one grounded query is available today.</summary>
    public bool CanGroundedQuery => GroundedRemaining > 0;

    /// <summary>
    /// Increments the daily counter and saves. Call ONLY after a successful
    /// API response.
    /// </summary>
    public void RecordGroundedQuery()
    {
        EnsureDateReset();
        DailyGroundedCount++;
        Save();
    }

    private void EnsureDateReset()
    {
        var today = DateTime.UtcNow.ToString("yyyy-MM-dd");
        if (GroundedCountDate == today) return;
        DailyGroundedCount = 0;
        GroundedCountDate  = today;
        Save();
    }

    public void Save() => Plugin.PluginInterface.SavePluginConfig(this);
}
