<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>4.7.0.7</Version>
    <Description>Displays market tax info, FC events, and more in a convenient UI.</Description>
    <PackageProjectUrl>https://github.com/Tihlyn/RedMoon-Cappuccino</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The Dalamud.NET.Sdk implicitly references:
      Dalamud.dll, DalamudPackager, Dalamud.Bindings.ImGui,
      FFXIVClientStructs, Lumina, Lumina.Excel, InteropGenerator.Runtime
    Do NOT add HintPath references for these.
  -->

  <ItemGroup>
    <!-- RotationRecorder sources (merged plugin) -->
    <Compile Include="..\RotationRecorder\ActionEvent.cs" />
    <Compile Include="..\RotationRecorder\ActionRecorder.cs" />
    <Compile Include="..\RotationRecorder\GeminiAnalyzer.cs" />
    <Compile Include="..\RotationRecorder\RecorderWindow.cs" />
    <Compile Include="..\RotationRecorder\RotationFormatter.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Data\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="Resources\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\resources\gear_db\*.json">
      <Link>Resources\planner\gear_db\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\resources\math\*.json">
      <Link>Resources\planner\math\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
    <Content Include="..\resources\bis\*.JSON">
      <Link>Resources\planner\bis\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
