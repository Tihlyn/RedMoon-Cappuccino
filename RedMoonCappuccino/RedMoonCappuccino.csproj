<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.2.0</Version>
    <Description>Displays FC server information: lowest market tax rate and event data.</Description>
    <PackageProjectUrl>https://github.com/Tihlyn/RedMoon-Cappuccino</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    The Dalamud.NET.Sdk implicitly references:
      Dalamud.dll, DalamudPackager, Dalamud.Bindings.ImGui,
      FFXIVClientStructs, Lumina, Lumina.Excel, InteropGenerator.Runtime
    Do NOT add HintPath references for these.
  -->

  <ItemGroup>
    <Content Include="..\Data\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
