  "formulas": {
    "_formulaNotation": {
      "fl": "floor() with floating-point tolerance (if fractional part >= 0.99999995, round up)",
      "cl": "ceil() with floating-point tolerance (if fractional distance >= 0.99999995, round down)",
      "flp(n, x)": "floor x to n decimal places using fl()",
      "trunc": "truncate toward zero (fl for positive, -fl(-x) for negative)",
      "baseSub": "levelStats.baseSubStat",
      "baseMain": "levelStats.baseMainStat",
      "div": "levelStats.levelDiv",
      "apMod": "mainStatPowerMod[role] ?? mainStatPowerMod.other"
    },

    "critChance": {
      "description": "Critical hit stat → crit rate (0.0–1.0)",
      "formula": "fl(200 * (crit - baseSub) / div + 50) / 1000",
      "coefficients": { "numeratorScale": 200, "divisor": 1000, "baseOffset": 50 }
    },
    "critDamage": {
      "description": "Critical hit stat → crit damage multiplier (F(CRIT))",
      "formula": "(1400 + fl(200 * (crit - baseSub) / div)) / 1000",
      "coefficients": { "base": 1400, "numeratorScale": 200, "divisor": 1000 }
    },
    "dhitChance": {
      "description": "Direct hit stat → DH rate (0.0–1.0)",
      "formula": "fl(550 * (dhit - baseSub) / div) / 1000",
      "coefficients": { "numeratorScale": 550, "divisor": 1000 }
    },
    "dhitDamage": {
      "description": "Direct hit damage multiplier (currently fixed)",
      "formula": "1.25",
      "notes": "Fixed value. Function exists in case SE changes this."
    },
    "determination": {
      "description": "Determination stat → damage multiplier (F(DET))",
      "formula": "(1000 + fl(140 * (det - baseMain) / div)) / 1000",
      "coefficients": { "base": 1000, "numeratorScale": 140, "divisor": 1000 },
      "notes": "Uses baseMainStat, not baseSubStat"
    },
    "tenacityDamage": {
      "description": "Tenacity stat → outgoing damage multiplier (F(TNC)). Tanks only.",
      "formula": "(1000 + fl(112 * (tenacity - baseSub) / div)) / 1000",
      "coefficients": { "base": 1000, "numeratorScale": 112, "divisor": 1000 }
    },
    "tenacityIncomingDamage": {
      "description": "Tenacity stat → incoming damage multiplier (mitigation)",
      "formula": "(1000 - fl(200 * (tenacity - baseSub) / div)) / 1000",
      "coefficients": { "base": 1000, "numeratorScale": 200, "divisor": 1000 }
    },
    "defenseIncomingDamage": {
      "description": "Defense/Magic Defense → incoming damage ratio",
      "formula": "max(0, (100 - fl(15 * defense / div)) / 100)",
      "coefficients": { "numeratorScale": 15 }
    },
    "speedToGcd": {
      "description": "Skill/Spell speed stat → GCD recast time. Same formula for SKS and SPS.",
      "formula": "max(0, fl(fl((1000 - fl(130 * (speed - baseSub) / div)) * baseGcd) * (100 - haste)) / 1000) / 100)",
      "coefficients": { "base": 1000, "numeratorScale": 130 },
      "params": {
        "baseGcd": "Base GCD time (typically 2.5)",
        "speed": "SKS or SPS stat value",
        "haste": "Haste percentage (0 = none, 15 = 15%)"
      }
    },
    "speedDotMultiplier": {
      "description": "Skill/Spell speed → DoT/HoT tick multiplier (F(SPD))",
      "formula": "(1000 + fl(130 * (speed - baseSub) / div)) / 1000",
      "coefficients": { "base": 1000, "numeratorScale": 130, "divisor": 1000 }
    },
    "mainStatMultiplier": {
      "description": "Main stat → damage multiplier (F(AP) / F(ATK))",
      "formula": "max(0, (trunc(apMod * (mainstat - baseMain) / baseMain) + 100) / 100)",
      "notes": "apMod comes from mainStatPowerMod: Tank=190, other=237 at level 100"
    },
    "weaponDamageMultiplier": {
      "description": "Weapon damage → damage multiplier (F(WD))",
      "formula": "fl(baseMain * jobMainStatMod / 1000 + wd) / 100",
      "notes": "jobMainStatMod is the job's stat multiplier for its main stat. For pet actions, jobMainStatMod is always 100."
    },
    "autoAttackMultiplier": {
      "description": "Auto-attack damage multiplier (f(AUTO))",
      "formula": "fl(fl(baseMain * jobAAStat / 1000 + weaponDamage) * (weaponDelay / 3)) / 100",
      "notes": "jobAAStat is the job's stat multiplier for its autoAttackStat"
    },
    "autoDhitBonusDamage": {
      "description": "Extra damage from DH stat on auto-DH abilities",
      "formula": "fl(140 * ((dhit - baseSub) / div)) / 1000",
      "coefficients": { "numeratorScale": 140, "divisor": 1000 }
    },
    "mpPerTick": {
      "description": "Piety stat → MP regen per tick",
      "formula": "200 + fl(150 * (piety - baseMain) / div)",
      "coefficients": { "base": 200, "numeratorScale": 150 },
      "notes": "Uses baseMainStat"
    },
    "vitToHp": {
      "description": "Vitality → HP",
      "formula": "fl(hp * jobHpMod / 100) + fl((vitality - baseMain) * hpScalar)",
      "notes": "hp is levelStats.hp; hpScalar is Tank-specific or 'other' per level"
    },
    "partyBonus": {
      "description": "Party bonus applied to main stat, AA stat, and vitality",
      "formula": "fl(stat * (1 + 0.01 * partyBonus))",
      "notes": "partyBonus is 0–5 representing unique roles"
    },
    "foodBonus": {
      "description": "Food stat bonus calculation",
      "formula": "min(food.max, floor(gearStatValue * food.percentage / 100))",
      "notes": "Applied on pre-party-bonus gear stat values"
    }
  },

  "damageCalculation": {
    "physicalMelee": {
      "description": "Standard damage formula for Melee/Ranged/Tank (non-caster, non-AA)",
      "steps": [
        "basePotency = fl(potency * mainStatMulti)",
        "afterDet    = fl(basePotency * detMulti)  [or detAutoDhMulti if auto-DH]",
        "afterTnc    = fl(afterDet * tncMulti)",
        "afterWd     = fl(afterTnc * wdMulti)",
        "afterSpd    = fl(afterWd * spdMulti)      [spdMulti = 1.0 unless DoT]",
        "final       = fl(afterSpd * traitMulti) + (potency < 100 ? 1 : 0)"
      ]
    },
    "casterHealer": {
      "description": "Caster/Healer damage formula (non-AA). Potency multiplied into WD first.",
      "steps": [
        "apDet       = flp(2, mainStatMulti * detMulti)  [or detAutoDhMulti if auto-DH]",
        "basePotency = fl(apDet * fl(wdMulti * potency))",
        "afterTnc    = fl(basePotency * tncMulti)",
        "afterSpd    = fl(afterTnc * spdMulti)     [spdMulti = 1.0 unless DoT]",
        "final       = fl(afterSpd * traitMulti) + (potency < 100 ? 1 : 0)"
      ],
      "notes": "Key difference: potency is multiplied into wdMulti and floored, then combined with ap*det (floored to 2 decimal places)."
    },
    "autoAttack": {
      "description": "Auto-attack damage. Uses aaStatMulti and aaMulti instead of mainStatMulti/wdMulti. spdMulti = sksDotMulti.",
      "steps": [
        "Same as physicalMelee but with aaStatMulti, aaMulti, and sksDotMulti for speed"
      ]
    },
    "expectedDamageWithCritDh": {
      "description": "Expected damage factoring in crit/DH RNG",
      "formula": "baseDamage * (1 + dhitChance * (dhitMulti - 1)) * (1 + critChance * (critMulti - 1))"
    },
    "healing": {
      "description": "Base healing formula (no variance, can crit but not DH)",
      "steps": [
        "basePotency = fl(potency * mainStatMulti * 100) / 100",
        "afterDet    = fl(basePotency * detMulti * 100) / 100",
        "afterTnc    = fl(afterDet * tncMulti * 100) / 100",
        "afterWd     = fl(afterTnc * wdMulti)",
        "afterTrait  = fl(fl(afterAutoCrit * traitMulti) / 100)"
      ]
    }
  },

  "hasteCalculation": {
    "description": "Combining multiple haste sources. Each haste type is converted to a speed multiplier, multiplied together, then converted back.",
    "formula": "fl((1 - flp(2, clp(2, flp(2, buffMult * traitMult) * gaugeMult) * gearMult)) * 100)",
    "multiplierConversion": "(100 - hastePercent) / 100",
    "combineBuffs": "fl(100 * (1 - flp(2, existingMult * nextMult)))"
  },

