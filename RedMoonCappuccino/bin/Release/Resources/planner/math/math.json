{
  "_meta": {
    "source": "https://github.com/xiv-gear-planner/gear-planner (packages/xivmath)",
    "dataApiSource": "https://data.xivgear.app/Jobs",
    "extractedDate": "2026-04-13",
    "notes": "Formulas are normalized to 1.0 (no impact = 1.0, +50% = 1.5). Uses fl() (floor with floating-point tolerance) throughout. Caster/Healer non-AA damage uses a different formula order than physical jobs."
  },

  "constants": {
    "normalGcd": 2.5,
    "maxGcd": 2.5,
    "standardAnimationLock": 0.6,
    "castSnapshotPre": 0.5,
    "casterTax": 0.1,
    "standardApplicationDelay": 0.6,
    "autoAttackApplicationDelay": 0.6,
    "meleeAutoPotency": 90,
    "rangedAutoPotency": 80,
    "directHitMultiplier": 1.25,
    "damageVarianceRange": { "min": 0.95, "max": 1.05 },
    "damageVarianceStdDev": "sqrt(0.01 / 12) * finalDamage",
    "maxPartyBonus": 5,
    "currentMaxLevel": 100,
    "supportedLevels": [70, 80, 90, 100],
    "materiaSlotMax": 5,
    "materiaLevelMaxNormal": 12,
    "materiaLevelMaxOvermeld": 11,
    "materiaAcceptableOvercapLoss": 2
  },

